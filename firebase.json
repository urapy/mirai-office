{
  "functions": {
    "source": "functions",
    "runtime": "nodejs22",
    "predeploy": ["npm --prefix \"$RESOURCE_DIR\" run build"]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": [
    {
      "target": "office",
      "public": "dist/webview",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "api",
            "region": "asia-northeast1",
            "pinTag": true
          }
        },
        { "source": "**", "destination": "/index.html" }
      ]
    },
    {
      "target": "account",
      "public": "brokerage-ui/dist",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [
        {
          "source": "/api/**",
          "function": {
            "functionId": "api",
            "region": "asia-northeast1",
            "pinTag": true
          }
        },
        { "source": "**", "destination": "/index.html" }
      ]
    }
  ]
}
